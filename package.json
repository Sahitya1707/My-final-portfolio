{
  "name": "sahitya-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Static portfolio and freelance site for Sahitya Neupane. Next.js static export, deployable to Cloudflare Pages at $0/month.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check && next build",
    "check": "tsc --noEmit && tsx scripts/check-projects.ts",
    "images": "node scripts/optimize-images.mjs",
    "preview": "npx --yes serve@14 out -l 4000",
    "sync": "tsx scripts/sync-github.ts",
    "test:sync": "tsx scripts/test-sync.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
