# Optional. Free access key from https://web3forms.com (enter your email, the key arrives by email).
# Without it the contact form still works: it opens the visitor's email app with the message filled in.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional. The public URL the site is served from, used for canonical links, sitemap and social cards.
# Defaults to the value in content/site.ts.
NEXT_PUBLIC_SITE_URL=

# Optional. Free Cloudflare Web Analytics token (Cloudflare dashboard → Analytics & Logs → Web Analytics →
# Add a site → copy the "token" value from the snippet). Shows visits, pages and referrers, with no cookies.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
